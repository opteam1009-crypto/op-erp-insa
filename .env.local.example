# Vercel → Storage에서 Neon을 연결하면 자동으로 주입된다.
# 로컬에서는 Neon 대시보드의 연결 문자열을 그대로 붙여넣는다.
DATABASE_URL=

# Vercel → Storage에서 Blob을 연결하면 자동으로 주입된다.
BLOB_READ_WRITE_TOKEN=

# 로그인 비밀번호. 이 앱의 인증은 이것 하나다.
APP_PASSWORD=

# 세션 쿠키 서명 키. openssl rand -hex 32
SESSION_SECRET=

# 알림을 보낼 Slack 채널의 incoming webhook. 없으면 크론은 돌지만 아무 데도 안 보낸다.
SLACK_WEBHOOK_URL=

# 크론 라우트의 Authorization: Bearer 검증값. Vercel Cron이 자동으로 붙여 보낸다.
CRON_SECRET=
